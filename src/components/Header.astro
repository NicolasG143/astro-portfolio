---
import { getProjects } from '../data/content';
import { profile } from '../data/profile';

const hasProjects = (await getProjects()).length > 0;
const links = [
  { label: 'Trabajos', href: '/#trabajos' },
  ...(hasProjects ? [{ label: 'Proyectos', href: '/#proyectos' }] : []),
  { label: 'Sobre mí', href: '/#sobre-mi' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-40 bg-paper/80 backdrop-blur-md" data-header transition:persist>
  <div class="wrap flex h-16 items-center justify-between gap-4 border-b border-transparent transition-colors" data-header-line>
    <a href="/" class="display group flex items-baseline text-[1.65rem] leading-none" aria-label="Tuty, ir al inicio">
      tuty<span class="ml-0.5 inline-block size-2.5 rounded-full bg-accent transition-transform group-hover:scale-150" aria-hidden="true"></span>
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm">
        {links.map((link) => (
          <li><a href={link.href} class="text-muted transition-colors hover:text-ink">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" class="btn hidden py-1.5 text-sm sm:inline-flex" data-copy={profile.email} data-status="header-copy-status">
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        <span data-copy-label>Copiar mail</span>
      </button>
      <span id="header-copy-status" class="sr-only" aria-live="polite"></span>
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full border border-line transition-colors hover:border-ink"
        aria-label="Usar modo oscuro"
      >
        <svg viewBox="0 0 24 24" class="size-4.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5"></circle>
          <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav aria-label="Principal, móvil" class="wrap -mt-1 pb-3 md:hidden">
    <ul class="flex gap-5 text-sm">
      {links.map((link) => (
        <li><a href={link.href} class="text-muted hover:text-ink">{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  import '../scripts/copy';

  const syncLabel = (button: HTMLButtonElement) => {
    const dark = document.documentElement.dataset.theme === 'dark';
    button.setAttribute('aria-label', dark ? 'Usar modo claro' : 'Usar modo oscuro');
  };

  const setup = () => {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const line = document.querySelector<HTMLElement>('[data-header-line]');
    if (!button || !line) return;

    syncLabel(button);
    if (button.dataset.ready) return;
    button.dataset.ready = 'true';

    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      syncLabel(button);
    });

    const onScroll = () => line.classList.toggle('border-line', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  document.addEventListener('astro:page-load', setup);
</script>
