---
import CopyButton from './CopyButton.astro';
import { getProfile } from '../data/profile';
import { toLang, useTranslations } from '../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const profile = getProfile(lang);
---

<section id="contacto" class="wrap scroll-mt-24 pt-28" aria-labelledby="contacto-title">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-end">
    <h2 id="contacto-title" class="display text-[clamp(4rem,13vw,11.5rem)]">{t('contact.title')}</h2>
    <div class="lg:pb-4">
      <p class="max-w-[40ch] text-lg leading-relaxed">{t('contact.body')}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${profile.email}`} class="btn btn-solid">{t('contact.write')}</a>
        <CopyButton
          value={profile.email}
          statusId="contact-copy-status"
          label={t('contact.copy', { email: profile.email })}
        />
      </div>
      <a href={profile.cv} target="_blank" rel="noopener noreferrer" class="link mt-6 inline-block">{t('cv.viewMine')}</a>
    </div>
  </div>
</section>
