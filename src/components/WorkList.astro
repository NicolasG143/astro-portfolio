---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { yearRange } from '../data/profile';
import { slugOf } from '../data/content';
import { jobPath, toLang, useTranslations } from '../i18n/ui';

interface Props {
  jobs: CollectionEntry<'jobs'>[];
}

const { jobs } = Astro.props;

const frequency = new Map<string, number>();
for (const job of jobs) {
  for (const tech of job.data.stack) frequency.set(tech, (frequency.get(tech) ?? 0) + 1);
}
// Only offer filters that narrow the list to more than one job; single-use tech stays visible per row.
const techs = [...frequency.entries()]
  .filter(([, count]) => count > 1)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tech]) => tech);

const key = (tech: string) => tech.toLowerCase();
const first = Math.min(...jobs.map((j) => j.data.start));
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="trabajos" class="scroll-mt-24 pt-6" aria-labelledby="trabajos-title" data-work>
  <h2 id="trabajos-title" class="sr-only">{t('work.title')}</h2>

  <div class="wrap mt-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <p class="max-w-[46ch] text-lg leading-relaxed">
      {t('work.intro', { year: first })}
    </p>
    <div>
      <div class="flex flex-wrap gap-2" role="group" aria-label={t('work.filter')}>
        <button type="button" class="chip" data-filter="" aria-pressed="true">{t('work.all')}</button>
        {techs.map((tech) => (
          <button type="button" class="chip" data-filter={key(tech)} aria-pressed="false">{tech}</button>
        ))}
      </div>
      <p
        class="mt-3 text-sm text-muted lg:text-right"
        aria-live="polite"
        data-count
        data-count-all={t('work.countAll')}
        data-count-one={t('work.countOne')}
        data-count-many={t('work.countMany')}
      >
        {t('work.countAll', { n: jobs.length })}
      </p>
    </div>
  </div>

  <ol class="wrap mt-8 border-t border-ink">
    {jobs.map((job, i) => {
      const { company, role, start, end, stack, gallery } = job.data;
      const cover = gallery[0];
      return (
        <li data-job={slugOf(job)} data-stack={stack.map(key).join('|')} class="border-b border-line">
          <a
            href={jobPath(lang, slugOf(job))}
            class="row grid grid-cols-[2.25rem_minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 px-2 py-6 transition-colors duration-200 sm:px-4 md:grid-cols-[3rem_minmax(0,1.5fr)_minmax(0,1fr)_7rem_2.75rem] md:py-8"
          >
            <span class="text-sm text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="display block text-[clamp(2rem,5vw,3.75rem)]" transition:name={`job-${slugOf(job)}`}>
                {company}
              </span>
              <span class="mt-2 block text-sm text-muted md:hidden">{role}, {yearRange(start, end)}</span>
            </span>
            {cover ? (
              <Image
                src={cover.src}
                alt=""
                width={160}
                height={112}
                class="h-14 w-20 rounded-xl object-cover object-top md:hidden"
              />
            ) : (
              <span class="md:hidden" />
            )}
            <span class="hidden text-muted md:block">
              {role}
              <span class="mt-1 block text-sm">{stack.slice(0, 3).join(', ')}</span>
            </span>
            <span class="hidden text-right tabular-nums md:block">{yearRange(start, end)}</span>
            <span class="arrow hidden size-11 place-items-center justify-self-end rounded-full border border-current md:grid" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8" /></svg>
            </span>
          </a>
        </li>
      );
    })}
  </ol>

  <div class="preview pointer-events-none fixed top-0 left-0 z-30 hidden w-[22rem]" aria-hidden="true" data-preview>
    {jobs.map((job) =>
      job.data.gallery[0] ? (
        <Image
          src={job.data.gallery[0].src}
          alt=""
          widths={[400, 720]}
          sizes="22rem"
          loading="lazy"
          data-preview-for={slugOf(job)}
          class="hidden aspect-[4/3] w-full rounded-[1.25rem] object-cover object-top shadow-[0_30px_60px_-20px_rgba(0,0,0,0.5)]"
        />
      ) : null,
    )}
  </div>
</section>

<style>
  .chip {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .chip:hover {
    border-color: var(--ink);
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .row:hover,
  .row:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .row:hover .text-muted,
  .row:focus-visible .text-muted {
    color: color-mix(in oklab, var(--paper) 70%, transparent);
  }

  .row:hover .arrow,
  .row:focus-visible .arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    transform: rotate(45deg);
  }

  .arrow {
    transition:
      transform 0.25s,
      background-color 0.2s;
  }

  .preview {
    transition: opacity 0.2s;
  }

  li[hidden] {
    display: none;
  }
</style>

<script>
  const setup = () => {
    const root = document.querySelector<HTMLElement>('[data-work]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const rows = [...root.querySelectorAll<HTMLElement>('[data-job]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const count = root.querySelector<HTMLElement>('[data-count]');

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter ?? '';
        for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
        let visible = 0;
        for (const row of rows) {
          const match = !filter || (row.dataset.stack ?? '').split('|').includes(filter);
          row.hidden = !match;
          if (match) visible++;
        }
        if (count) {
          // Templates come from the page language: {n} and {tech} are filled in here.
          const template = !filter
            ? count.dataset.countAll
            : visible === 1
              ? count.dataset.countOne
              : count.dataset.countMany;
          count.textContent = (template ?? '')
            .replace('{n}', String(filter ? visible : rows.length))
            .replace('{tech}', chip.textContent?.trim() ?? '');
        }
      });
    }

    // Cursor-following preview: only for a fine pointer that can hover, and never with reduced motion.
    const preview = root.querySelector<HTMLElement>('[data-preview]');
    const canPreview = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches;
    if (!preview || !canPreview) return;

    const images = [...preview.querySelectorAll<HTMLElement>('[data-preview-for]')];
    let x = 0;
    let y = 0;
    let frame = 0;

    const place = () => {
      frame = 0;
      const width = preview.offsetWidth;
      const left = x + 24 + width > window.innerWidth ? x - width - 24 : x + 24;
      preview.style.transform = `translate(${left}px, ${y - preview.offsetHeight / 2}px)`;
    };

    for (const row of rows) {
      const image = images.find((img) => img.dataset.previewFor === row.dataset.job);
      if (!image) continue;
      row.addEventListener('pointerenter', () => {
        for (const img of images) img.classList.toggle('hidden', img !== image);
        preview.classList.remove('hidden');
      });
      row.addEventListener('pointerleave', () => preview.classList.add('hidden'));
      row.addEventListener('pointermove', (event) => {
        x = event.clientX;
        y = event.clientY;
        if (!frame) frame = requestAnimationFrame(place);
      });
    }
  };

  document.addEventListener('astro:page-load', setup);
</script>
