---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { slugOf } from '../data/content';
import { projectPath, toLang, useTranslations } from '../i18n/ui';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="proyectos" class="wrap scroll-mt-20 pt-28" aria-labelledby="proyectos-title">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <h2 id="proyectos-title" class="display text-5xl sm:text-7xl">
      {t('projects.title')}
    </h2>
    <p class="max-w-[42ch] text-muted">{t('projects.intro')}</p>
  </div>

  <ul class="mt-10 grid gap-x-10 md:grid-cols-2">
    {
      projects.map((project) => {
        const { name, year, summary, stack, links, gallery } = project.data;
        const slug = slugOf(project);
        const href = projectPath(lang, slug);
        const cover = gallery[0];
        return (
          <li class="flex flex-col border-t border-line py-8">
            {cover && (
              <a href={href} class="group mb-6 block overflow-hidden rounded-[1.5rem] bg-accent p-2 sm:p-3" tabindex="-1" aria-hidden="true">
                <Image
                  src={cover.src}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(min-width: 48rem) 44rem, 100vw"
                  class="h-auto w-full rounded-[1.1rem] transition-transform duration-500 group-hover:scale-[1.02]"
                />
              </a>
            )}
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="display text-3xl" transition:name={`project-${slug}`}>
                <a href={href} class="hover:text-accent">{name}</a>
              </h3>
              <span class="text-sm text-muted tabular-nums">{year}</span>
            </div>
            <p class="mt-3 max-w-[52ch] leading-relaxed">{summary}</p>
            <p class="mt-3 text-sm text-muted">{stack.join(', ')}</p>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
              <li>
                <a href={href} class="link font-medium">
                  {t('project.view')}
                  <span class="sr-only">: {name}</span>
                </a>
              </li>
              {links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="link font-medium">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ul>
</section>
