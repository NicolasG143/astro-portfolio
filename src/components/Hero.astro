---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { profile } from '../data/profile';

interface Props {
  jobs: CollectionEntry<'jobs'>[];
}

const showcase = Astro.props.jobs
  .filter((job) => job.data.gallery.length > 0)
  .map((job) => ({ id: job.id, company: job.data.company, shot: job.data.gallery[0] }));
---

<section class="wrap pt-8 pb-16 sm:pt-12" aria-labelledby="hero-title">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:gap-8">
    <div class="flex flex-col">
      <p class="text-muted">{profile.name}, “{profile.nickname}”. {profile.location}.</p>
      <h1 id="hero-title" class="display hero-title mt-4 text-[clamp(4.2rem,13.5vw,12.5rem)]">
        software<br />engineer
      </h1>
      <p class="mt-8 max-w-[44ch] text-lg leading-relaxed lg:ml-auto lg:text-right">
        Hago sitios y sistemas web rápidos, accesibles y fáciles de usar. Trabajo con Next.js, React,
        Node.js y Astro: diseño la interfaz, escribo la lógica del servidor y cuido la infraestructura
        que lo sostiene.
      </p>

      <div class="mt-auto grid gap-8 border-t border-line pt-8 sm:grid-cols-[auto_1fr_1fr] sm:items-end lg:mt-12">
        <ul class="flex gap-2" aria-label="Redes">
          {profile.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn px-3.5 py-1.5 text-sm">{s.label}</a>
            </li>
          ))}
        </ul>
        <div>
          <p class="display text-5xl">+15 TB</p>
          <p class="mt-2 max-w-[26ch] text-sm text-muted">de ataques DDoS mitigados con Cloudflare en FúriusAO.</p>
        </div>
        <div>
          <p class="display text-5xl">+60</p>
          <p class="mt-2 max-w-[26ch] text-sm text-muted">campos de un formulario convertidos en un cotizador por pasos.</p>
        </div>
      </div>
    </div>

    {showcase.length > 0 && (
      <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-3" data-showcase>
        <div class="relative flex flex-col overflow-hidden rounded-[2.25rem] bg-accent p-4 sm:p-6">
          {showcase.map((item, i) => (
            <a
              href={`/trabajos/${item.id}/`}
              class="group flex flex-1 flex-col"
              data-slide={item.id}
              hidden={i !== 0}
            >
              <div class="relative aspect-[4/3] overflow-hidden rounded-[1.4rem] bg-black shadow-[0_24px_48px_-24px_rgba(0,0,0,0.55)] lg:aspect-auto lg:min-h-[18rem] lg:flex-1">
                <Image
                  src={item.shot.src}
                  alt={item.shot.alt}
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 64rem) 38vw, 90vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="absolute inset-0 size-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                />
              </div>
              <p class="mt-4 flex items-center justify-between gap-3 text-on-accent">
                <span class="display text-3xl sm:text-4xl">{item.company}</span>
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-black text-white transition-transform group-hover:rotate-45" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8" /></svg>
                </span>
                <span class="sr-only">Ver el trabajo</span>
              </p>
            </a>
          ))}
        </div>
        <ul class="flex flex-col gap-3" aria-label="Elegir trabajo destacado">
          {showcase.map((item, i) => (
            <li>
              <button
                type="button"
                class="thumb block size-14 overflow-hidden rounded-full border-2 border-transparent sm:size-16"
                data-show={item.id}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-label={`Mostrar ${item.company}`}
              >
                <Image src={item.shot.src} alt="" width={128} height={128} class="size-full object-cover object-top" />
              </button>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .hero-title {
    animation: settle 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes settle {
    from {
      font-weight: 300;
      font-stretch: 75%;
      letter-spacing: 0.01em;
    }
  }

  .thumb {
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .thumb:hover {
    transform: scale(1.06);
  }

  .thumb[aria-pressed='true'] {
    border-color: var(--ink);
  }
</style>

<script>
  const setup = () => {
    const root = document.querySelector<HTMLElement>('[data-showcase]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-show]')];

    for (const thumb of thumbs) {
      thumb.addEventListener('click', () => {
        for (const slide of slides) slide.hidden = slide.dataset.slide !== thumb.dataset.show;
        for (const other of thumbs) other.setAttribute('aria-pressed', String(other === thumb));
      });
    }
  };

  document.addEventListener('astro:page-load', setup);
</script>
