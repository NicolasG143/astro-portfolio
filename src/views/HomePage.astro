---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WorkList from '../components/WorkList.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { getJobs, getProjects, homeAlternates } from '../data/content';
import { getProfile } from '../data/profile';
import { homePath, langs, toLang, useTranslations } from '../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const profile = getProfile(lang);
const [jobs, projects] = await Promise.all([getJobs(lang), getProjects(lang)]);
const site = Astro.site ?? Astro.url;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.nickname,
  jobTitle: profile.role,
  description: t('meta.description'),
  url: new URL(homePath(lang), site).href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  sameAs: profile.social.map((s) => s.url),
  knowsAbout: profile.skills.filter((_, i) => i < 3).flatMap((s) => s.items),
  knowsLanguage: langs,
};
---

<Layout
  title={t('meta.title')}
  description={t('meta.description')}
  alternates={homeAlternates}
  image={`/og/${lang}.png`}
  structuredData={person}
>
  <Hero jobs={jobs} />
  <Marquee word={t('work.marquee')} accent />
  <WorkList jobs={jobs} />
  {projects.length > 0 && <Projects projects={projects} />}
  <About />
  <Contact />
</Layout>
