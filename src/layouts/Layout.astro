---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, langs, toLang, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** The same page in every locale, used for hreflang and the language switcher. */
  alternates: Record<Lang, string>;
  /** Site-relative path of the Open Graph card for this page (see src/pages/og). */
  image?: string;
  type?: 'website' | 'article';
  /** For pages that must stay out of search results (404): no canonical or hreflang either. */
  noindex?: boolean;
  /** schema.org data, rendered as JSON-LD. */
  structuredData?: Record<string, unknown>;
}

const { title, description, alternates, image, type = 'website', noindex = false, structuredData } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const ogLocale: Record<Lang, string> = { es: 'es_AR', en: 'en_US' };
const imageUrl = image ? new URL(image, site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], site)} />}
    <meta property="og:site_name" content="tuty.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <meta name="theme-color" content="#f4f2f8" />
    <script is:inline>
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme !== 'light' && theme !== 'dark') {
            theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {t('skip')}
    </a>
    <Header alternates={alternates} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
