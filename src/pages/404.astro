---
import Layout from '../layouts/Layout.astro';
import { homeAlternates } from '../data/content';
---

<Layout title="Página no encontrada · Page not found" description="Esta página no existe. This page doesn't exist." alternates={homeAlternates} noindex>
  <section class="wrap pt-24 sm:pt-36">
    <h1 class="display text-6xl sm:text-8xl">Esta página no existe.</h1>
    <p class="mt-6 max-w-[50ch] text-lg text-muted">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <a href="/" class="btn btn-solid mt-8">Ir al inicio</a>

    <div lang="en" class="mt-16 border-t border-line pt-10">
      <p class="display text-4xl sm:text-5xl">This page doesn’t exist.</p>
      <p class="mt-4 max-w-[50ch] text-lg text-muted">The link may be mistyped, or the page may have moved.</p>
      <a href="/en/" class="btn mt-6">Go to the home page</a>
    </div>
  </section>
</Layout>
