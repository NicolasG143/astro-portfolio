---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getJobs } from '../../data/content';
import { yearRange } from '../../data/profile';

export const getStaticPaths = (async () => {
  const jobs = await getJobs();
  return jobs.map((job, index) => ({
    params: { id: job.id },
    props: { job, next: jobs[(index + 1) % jobs.length] },
  }));
}) satisfies GetStaticPaths;

const { job, next } = Astro.props;
const { company, role, start, end, summary, stack, links, gallery } = job.data;
const { Content } = await render(job);
const [cover, ...rest] = gallery;
---

<Layout title={`${company}, trabajo de Nicolás Giménez`} description={summary}>
  <article>
    <header class="wrap pt-8 sm:pt-12">
      <a href="/#trabajos" class="link text-sm text-muted">Volver a todos los trabajos</a>
      <h1 class="display mt-8 text-[clamp(3.5rem,11vw,10rem)] text-balance" transition:name={`job-${job.id}`}>
        {company}
      </h1>

      <div class="mt-12 grid gap-10 border-t border-ink pt-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
        <p class="max-w-[46ch] text-xl leading-relaxed sm:text-2xl">{summary}</p>
        <dl class="text-base">
          <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 border-b border-line pb-4">
            <dt class="text-muted">Rol</dt>
            <dd>{role}</dd>
          </div>
          <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 border-b border-line py-4">
            <dt class="text-muted">Período</dt>
            <dd class="tabular-nums">{yearRange(start, end)}</dd>
          </div>
          <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 border-b border-line py-4">
            <dt class="text-muted">Tecnologías</dt>
            <dd>{stack.join(', ')}</dd>
          </div>
          {links.length > 0 && (
            <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 py-4">
              <dt class="text-muted">Enlaces</dt>
              <dd>
                <ul class="space-y-1">
                  {links.map((link) => (
                    <li><a href={link.url} target="_blank" rel="noopener noreferrer" class="link">{link.label}</a></li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </header>

    {cover && (
      <figure class="wrap mt-14">
        <div class="overflow-hidden rounded-[2rem] bg-accent p-3 sm:p-6">
          <Image
            src={cover.src}
            alt={cover.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 88rem) 88rem, 100vw"
            loading="eager"
            class="h-auto w-full rounded-[1.4rem]"
          />
        </div>
        <figcaption class="mt-3 text-sm text-muted">{cover.caption}</figcaption>
      </figure>
    )}

    <div class="wrap mt-6">
      <div class="prose lg:ml-[calc(100%/2.2)]">
        <Content />
      </div>
    </div>

    {rest.length > 0 && (
      <section class="wrap mt-16 grid gap-10" aria-label="Más capturas">
        {rest.map((shot) => (
          <figure>
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 88rem) 88rem, 100vw"
              class="h-auto w-full rounded-[2rem] border border-line"
            />
            <figcaption class="mt-3 text-sm text-muted">{shot.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    {next && next.id !== job.id && (
      <nav aria-label="Siguiente trabajo" class="wrap mt-28 border-t border-ink pt-8">
        <a href={`/trabajos/${next.id}/`} class="group block">
          <span class="text-muted">Siguiente trabajo</span>
          <span class="display mt-3 flex items-center gap-6 text-[clamp(3rem,9vw,8rem)]">
            {next.data.company}
            <span class="grid size-14 shrink-0 place-items-center rounded-full bg-ink text-paper transition-transform group-hover:rotate-45 group-hover:bg-accent group-hover:text-on-accent sm:size-20" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-6 sm:size-8" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8" /></svg>
            </span>
          </span>
        </a>
      </nav>
    )}
  </article>
</Layout>
